// ============================================
// MODULE: STOCK
// ============================================

model Product {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  code          String
  barcode       String?
  name          String
  description   String?
  category      String?
  unit          String   @default("unit")
  purchasePrice Decimal  @default(0)
  salePrice     Decimal  @default(0)
  vatRate       Decimal  @default(19)
  fodec         Boolean  @default(false)
  minStock      Decimal  @default(0)
  currentStock  Decimal  @default(0)
  /// Coût moyen unitaire pondéré (CMUP), recalculé à chaque entrée
  averageCost   Decimal  @default(0)
  /// Point de commande : en dessous (ou égal), le produit apparaît dans « à commander »
  reorderPoint  Decimal  @default(0)
  /// Quantité de réapprovisionnement suggérée (0 = calcul automatique)
  reorderQty    Decimal  @default(0)
  images        String[] @default([])
  variants      Json     @default("[]")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  movements      StockMovement[]
  warehouseStock ProductWarehouse[]
  inventoryItems InventoryItem[]
  transferItems  StockTransferItem[]
  receiptItems   GoodsReceiptItem[]
  returnItems    SupplierReturnItem[]

  @@unique([tenantId, code])
}

model StockMovement {
  id           String            @id @default(uuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  type         StockMovementType
  quantity     Decimal
  unitPrice    Decimal?
  reference    String?
  notes        String?
  warehouseId  String?
  warehouse    Warehouse?        @relation(fields: [warehouseId], references: [id])
  /// Motif (achat, vente, casse, perte, ajustement d'inventaire…)
  reason       String?
  /// Origine : MANUAL, PURCHASE, SALE, POS, TRANSFER, INVENTORY, OPENING
  sourceType   String?
  sourceId     String?
  /// Stock du dépôt après le mouvement
  balanceAfter Decimal?
  /// CMUP du produit après le mouvement
  costAfter    Decimal?
  createdById  String?
  createdAt    DateTime          @default(now())

  @@index([tenantId, productId])
  @@index([tenantId, warehouseId, createdAt])
  @@index([tenantId, createdAt])
}

enum StockMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  TRANSFER
}

// ============================================
// MODULE: WAREHOUSE
// ============================================

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  code      String
  name      String
  address   String?
  manager   String?
  phone     String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryItems  InventoryItem[]
  transfersFrom   StockTransfer[]    @relation("TransferFrom")
  transfersTo     StockTransfer[]    @relation("TransferTo")
  productStock    ProductWarehouse[]
  stockMovements  StockMovement[]
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  supplierReturns SupplierReturn[]
  inventories     Inventory[]
  deliveryNotes   Invoice[]

  @@unique([tenantId, code])
}

model ProductWarehouse {
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stock       Decimal   @default(0)
  /// Seuil d'alerte propre au dépôt (null = seuil du produit)
  minStock    Decimal?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@id([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

// ============================================
// MODULE: INVENTORY
// ============================================

model Inventory {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  warehouseId String?
  warehouse   Warehouse?      @relation(fields: [warehouseId], references: [id])
  reference   String
  date        DateTime
  status      InventoryStatus @default(DRAFT)
  /// FULL (tout le dépôt) ou CATEGORY
  scope       String          @default("FULL")
  category    String?
  validatedAt DateTime?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items InventoryItem[]

  @@unique([tenantId, reference])
  @@index([tenantId, warehouseId, status])
  @@index([tenantId, date])
}

enum InventoryStatus {
  DRAFT
  IN_PROGRESS
  VALIDATED
  CANCELLED
}

model InventoryItem {
  id          String     @id @default(uuid())
  inventoryId String
  inventory   Inventory  @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  expectedQty Decimal
  actualQty   Decimal
  unitCost    Decimal?
  variance    Decimal    @default(0)
  /// true quand la quantité a été saisie au comptage
  counted     Boolean    @default(false)
  notes       String?

  @@index([inventoryId])
}

// ============================================
// MODULE: STOCK TRANSFER
// ============================================

model StockTransfer {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  reference       String
  date            DateTime
  fromWarehouseId String
  fromWarehouse   Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  status          TransferStatus @default(DRAFT)
  validatedAt     DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items StockTransferItem[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([tenantId, date])
}

enum TransferStatus {
  DRAFT
  IN_PROGRESS
  TRANSFERRED
  CANCELLED
}

model StockTransferItem {
  id         String        @id @default(uuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Decimal
  notes      String?
}

// ============================================
// MODULE: STOCK — RÉFÉRENTIELS
// ============================================

model ProductCategory {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
}

model StockUnit {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  code      String
  name      String
  /// Nombre de décimales autorisées (0 pour pièces, 3 pour kg…)
  decimals  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}
